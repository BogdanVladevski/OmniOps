root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,jsx,ts,tsx,css,html,md}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Language
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: private fields are _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Analyzer tuning
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage delegates: not worth it at this scale
dotnet_diagnostic.CA1873.severity = none      # same: logging arguments are cheap here
dotnet_diagnostic.CA1062.severity = none      # nullable reference types cover argument null checks
dotnet_diagnostic.CA2007.severity = none      # no SynchronizationContext in ASP.NET Core
dotnet_diagnostic.CA1716.severity = none      # "Shared"/"Domain" namespaces are fine
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1515.severity = none      # public types are part of the app's internal contracts
dotnet_diagnostic.CA1812.severity = none      # handlers are created by DI
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1307.severity = suggestion
dotnet_diagnostic.CA1308.severity = none      # emails and codes are normalised to lower case on purpose
dotnet_diagnostic.CA1311.severity = suggestion
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1031.severity = none      # background work deliberately catches and logs
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA2227.severity = none      # EF navigation collections are settable
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.IDE0005.severity = warning  # unused usings
dotnet_diagnostic.IDE0161.severity = warning  # file-scoped namespaces

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
