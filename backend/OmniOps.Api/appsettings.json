{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "EnablePrometheusMetrics": true,
    "PrometheusEndpoint": "/metrics"
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "127.0.0.1",
    "Port": 5433,
    "Database": "OmniOps",
    "Username": "postgres",
    "Password": "",
    "ConnectionString": ""
  },
  "Ingestion": {
    "QueueCapacity": 10000,
    "ProcessingRetryMaxAttempts": 3,
    "ProcessingRetryDelayMilliseconds": 500
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:19006,http://localhost:3000"
  },
  "Fleet": {
    "VehicleIds": "Truck-001,Truck-002,Truck-003"
  }
}
