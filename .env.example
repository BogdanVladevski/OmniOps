# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5031

# PostgreSQL Data Store Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=OmniOps
DB_PORT=5433
DB_HOST=127.0.0.1
DB_CONNECTION_STRING=Host=127.0.0.1;Port=5433;Database=OmniOps;Username=postgres;Password=123

# Telemetry ingestion (in-process queue + bounded retries)
# INGESTION_QUEUE_CAPACITY=10000
# INGESTION_RETRY_MAX_ATTEMPTS=3
# INGESTION_RETRY_DELAY_MS=500

# Uploaded delivery photos (relative paths resolve against the API content root)
# STORAGE_ROOT_PATH=data/uploads

# Public address customers use for tracking and invoice links (put your real domain here in production)
PUBLIC_BASE_URL=http://localhost:5031

# Where the office app runs: invitation and password-reset links open it
APP_BASE_URL=http://localhost:19006

# Outgoing email for invoices and payment reminders. Leave SMTP_HOST empty to only log emails;
# the app then offers "copy link" and lists reminders for you to send yourself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
EMAIL_FROM=
# INVOICE_REMINDER_INTERVAL_MINUTES=60

# Client Web / Mobile Security Origins
ALLOWED_CORS_ORIGINS=http://localhost:19006,http://localhost:3000

# Sign-in. Keep this on; turning it off is only allowed in Development and makes every request the demo company.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_ISSUER=OmniOps
JWT_AUDIENCE=OmniOps.Clients
JWT_EXPIRATION_MINUTES=60
JWT_REQUIRE_AUTHENTICATION=true

# Simulate endpoint rate limiting (per client IP)
SIMULATE_RATE_LIMIT_PERMIT_LIMIT=10
SIMULATE_RATE_LIMIT_WINDOW_SECONDS=60

# Structured logging (Serilog)
SERILOG_MINIMUM_LEVEL=Information

# Prometheus metrics scrape endpoint (GET /metrics)
PROMETHEUS_METRICS_ENABLED=true

# Fleet vehicles tracked by the API (comma-separated) — keep frontend/.env EXPO_PUBLIC_FLEET_VEHICLES in sync
FLEET_VEHICLE_IDS=Truck-001,Truck-002,Truck-003

# CACHE_SLIDING_EXPIRATION_MINUTES=60
# CACHE_ABSOLUTE_EXPIRATION_HOURS=24
