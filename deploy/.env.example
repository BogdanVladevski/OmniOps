# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Database password (any long random string).
POSTGRES_PASSWORD=

# Signs sign-in tokens. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# Where people reach the product: public pages (tracking, invoices) and the app (invitations, password resets).
PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com

# Outgoing email for invoices, reminders, invitations and password resets.
# Leave SMTP_HOST empty to send nothing: the app then offers "copy link" instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
